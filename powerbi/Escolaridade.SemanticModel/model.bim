            "sourceColumn": "populacao_com_renda",
            "summarizeBy": "none"
          },
          {
            "name": "etapa_ensino_ordem",
            "dataType": "int64",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "777172a7-78b1-439e-8ca6-ccf7a2bc5a84",
            "sourceColumn": "etapa_ensino_ordem",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "7b7eab42-6bcc-4112-acfa-466852f75852",
        "measures": [
          {
            "name": "População",
            "expression": "SUM(PNAD[populacao])",
            "formatString": "#,0",
            "lineageTag": "bba5779c-d2b6-459c-962e-5b640fd2e1c3"
          },
          {
            "name": "% da População",
            "expression": "DIVIDE([População], CALCULATE([População], ALL(PNAD[Escolaridade], PNAD[escolaridade_ordem], PNAD[Etapa de ensino], PNAD[etapa_ensino_ordem])))",
            "formatString": "0.0%",
            "lineageTag": "e8b44eab-498a-42d2-9e02-e4f37d2ff2f6"
          },
          {
            "name": "% Superior Completo",
            "description": "Pessoas com graduação completa ou mais (especialização, mestrado, doutorado), entre quem tem nível de instrução informado.",
            "expression": [
              "DIVIDE(",
              "    CALCULATE([População], PNAD[escolaridade_ordem] >= 7),",
              "    CALCULATE([População], PNAD[escolaridade_ordem] >= 1)",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "c7fcdc97-dee0-4326-849c-754c64780b10"
          },
          {
            "name": "% Pós-graduação",
            "description": "Pessoas com especialização, mestrado ou doutorado.",
            "expression": [
              "DIVIDE(",
              "    CALCULATE([População], PNAD[escolaridade_ordem] >= 8),",
              "    CALCULATE([População], PNAD[escolaridade_ordem] >= 1)",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "bd6ddbea-e267-48b6-938e-c880493d495e"
          },
          {
            "name": "Média Anos de Estudo",
            "expression": "DIVIDE(SUM(PNAD[soma_anos_estudo]), SUM(PNAD[populacao_anos_estudo]))",
            "formatString": "0.0",
            "lineageTag": "5a4b1bec-5ef5-45bd-97ea-648b016f40b1"
          },
          {
            "name": "Renda Média do Trabalho",
            "expression": "DIVIDE(SUM(PNAD[soma_renda]), SUM(PNAD[populacao_com_renda]))",
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "fc2ebe34-db02-467e-ac7c-078a967db12a"
          }
        ],
        "partitions": [
          {
            "name": "PNAD",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(PastaDados & \"escolaridade_powerbi.csv\"), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"ano\", Int64.Type}, {\"trimestre\", Int64.Type}, {\"periodo\", type text}, {\"uf\", type text}, {\"regiao\", type text}, {\"genero\", type text}, {\"cor_raca\", type text}, {\"faixa_etaria_ordem\", Int64.Type}, {\"faixa_etaria\", type text}, {\"escolaridade_ordem\", Int64.Type}, {\"escolaridade\", type text}, {\"etapa_ensino\", type text}, {\"classe_ordem\", Int64.Type}, {\"classe_social\", type text}, {\"populacao\", type number}, {\"amostra\", Int64.Type}, {\"soma_anos_estudo\", type number}, {\"populacao_anos_estudo\", type number}, {\"soma_renda\", type number}, {\"populacao_com_renda\", type number}}, \"pt-BR\"),",
                "    EtapaOrdem = Table.AddColumn(Tipos, \"etapa_ensino_ordem\", each",
                "        if [etapa_ensino] = \"Sem instrução\" then 1",
                "        else if [etapa_ensino] = \"Educação básica\" then 2",
                "        else if [etapa_ensino] = \"Ensino superior\" then 3",
                "        else if [etapa_ensino] = \"Pós-graduação\" then 4",
                "        else 5, Int64.Type),",
                "    Renomeado = Table.RenameColumns(EtapaOrdem, {{\"ano\", \"Ano\"}, {\"trimestre\", \"Trimestre\"}, {\"periodo\", \"Período\"}, {\"uf\", \"UF\"}, {\"regiao\", \"Região\"}, {\"genero\", \"Gênero\"}, {\"cor_raca\", \"Cor/raça\"}, {\"faixa_etaria\", \"Faixa etária\"}, {\"escolaridade\", \"Escolaridade\"}, {\"etapa_ensino\", \"Etapa de ensino\"}, {\"classe_social\", \"Classe social\"}})",
                "in",
                "    Renomeado"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}